{
  "name": "quantbay",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.worker.config.ts && vite build --config vite.cleaner.config.ts && vite build --config vite.pro-worker.config.ts && npm run normalize:bundles",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build:cleaner": "vite build --config vite.cleaner.config.ts",
    "build:pro-worker": "vite build --config vite.pro-worker.config.ts",
    "normalize:bundles": "node scripts/normalize-bundles.mjs"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "papaparse": "5.4.1"
  }
}
