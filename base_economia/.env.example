# Conexión PostgreSQL directa. Debe poder escribir en el esquema privado
# `economia`; no es una URL para usar en el navegador.
DATOS_DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres?sslmode=require

# Storage privado de Supabase. También se acepta DATOS_CLAVE_SERVIDOR en lugar
# de SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar

# Opcionales: estos son los valores por defecto.
DATOS_SCHEMA=economia
DATOS_STORAGE_BUCKET=economia-crudos
