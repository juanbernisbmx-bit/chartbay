# Copia este archivo a ".env" y rellena los valores reales.
#
# ChartBay no necesita nada más: no hay login, sesión ni clave de IA. No
# agregues ANTHROPIC_API_KEY ni credenciales, que nada las lee.

# --- Sección Datos: FRED (series macro oficiales) ---
# Datos está escondida por ahora (SECCIONES en web/app.py); la clave sólo
# importa si se vuelve a mostrar. Es GRATUITA:
# https://fredaccount.stlouisfed.org/apikeys
# Sin ella World Bank sigue funcionando; sólo FRED se desactiva.
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
