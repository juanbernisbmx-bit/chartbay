# Copia este archivo a ".env" y rellena los valores reales.

# --- IA (para el veredicto técnico) ---
# Consigue tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Datos Frecuentes: FRED (series macro oficiales) ---
# Clave GRATUITA: https://fredaccount.stlouisfed.org/apikeys
# Sin esta clave la sección "Datos" se ve pero las descargas quedan desactivadas.
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Acceso a la web (login de un solo usuario) ---
APP_USERNAME=tu-usuario
APP_PASSWORD=cambia-esta-clave
# Clave secreta para las sesiones (pon una cadena larga y aleatoria).
SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria
