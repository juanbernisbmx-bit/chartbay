# Copia este archivo a ".env" y rellena los valores reales.

# --- Datos Frecuentes: FRED (series macro oficiales) ---
# Clave GRATUITA: https://fredaccount.stlouisfed.org/apikeys
# Sin esta clave la sección se ve y World Bank funciona; sólo FRED se desactiva.
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Desarrollo local ---
# Render genera SECRET_KEY. En local puede omitirse: la app usa un fallback de
# desarrollo. Login, SQLite y Mercados no participan del despliegue 1.0.
SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria

# --- Código heredado, sólo para auditoría local de Mercados ---
# Un único flag NO devuelve una sección lista para producción: también hacen
# falta persistencia y QA funcional. No configurar estas variables en Render 1.0.
CHARTBAY_SECCIONES=mercados=off
APP_USERNAME=tu-usuario
APP_PASSWORD=cambia-esta-clave
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
