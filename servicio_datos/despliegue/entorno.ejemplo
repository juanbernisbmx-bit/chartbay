# Secretos y configuración del servicio de datos. Se instala como /etc/chartbay-datos/entorno.
#
# Dueño: chartbay-datos. Permisos: 600 (chmod 600). El lanzador de tareas se niega a usarlo si lo puede leer
# otro usuario. Formato CLAVE=valor, sin "export" ni expansión de variables (systemd y el lanzador lo leen igual).
# NO guardar acá la URL del administrador de Supabase (SUPABASE_ADMIN_DATABASE_URL): solo se usa a mano, para
# instalar o migrar, y no tiene nada que hacer en el servidor.

# --- Base de datos (Supabase, rol datos_escritura; ver docs/despliegue-supabase.md) ---
DATOS_DATABASE_URL='postgresql://datos_escritura.PROJECT_REF:CLAVE@HOST_DEL_POOLER:5432/postgres?sslmode=require'

# --- Archivos originales descargados: carpeta persistente, con respaldo ---
DATOS_CRUDO_DIR=/var/lib/chartbay-datos/crudo
# Carpeta donde las tareas dejan sus bloqueos (que dos corridas no se pisen)
DATOS_RUN_DIR=/var/lib/chartbay-datos

# --- Interfaz de revisión ---
# Un usuario=hash por revisor, separados por ;  (se generan con: python -m servicio_datos.revision clave USUARIO)
DATOS_REVISORES='USUARIO=HASH'
# Dirección pública (HTTPS) de la interfaz: sale en los enlaces de los avisos
DATOS_REVISION_URL=https://revision.ejemplo.org
# Detrás del proxy con HTTPS. 1 = tomar de él la dirección del visitante, el host y el esquema.
# Solo con la app escuchando en 127.0.0.1 y un único proxy delante.
DATOS_REVISION_PROXY=1

# --- Avisos (los canales que falten no se usan; sin ninguno no se avisa nada) ---
# Slack: es una credencial. Tiene que ser https://hooks.slack.com/...
DATOS_AVISOS_SLACK_URL=
# Correo
DATOS_AVISOS_SMTP_HOST=
DATOS_AVISOS_SMTP_PUERTO=587
DATOS_AVISOS_SMTP_USUARIO=
DATOS_AVISOS_SMTP_CLAVE=
DATOS_AVISOS_SMTP_SEGURIDAD=starttls
DATOS_AVISOS_DE=
DATOS_AVISOS_PARA=
# Días hasta el primer recordatorio de un candidato abierto (0 los apaga)
DATOS_AVISOS_RECORDATORIO_DIAS=3

# --- Analista de hallazgos: modelo de lenguaje LOCAL (Ollama, llama.cpp, LM Studio...) ---
# Sin DATOS_AGENTE_MODELO el analista no usa ningún modelo: solo repite lo que una persona ya decidió sobre hallazgos
# idénticos. No lleva claves y los datos no salen del equipo: la dirección tiene que ser localhost o 127.0.0.1.
# Para elegir modelo: python -m servicio_datos.agente probar  (mide cuántos casos de prueba clasifica bien)
DATOS_AGENTE_MODELO=
DATOS_AGENTE_URL=http://127.0.0.1:11434/v1
# Segundos de espera por cada respuesta del modelo (entre 5 y 3600)
DATOS_AGENTE_TIMEOUT=180
